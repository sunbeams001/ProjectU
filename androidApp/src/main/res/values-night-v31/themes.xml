<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 启动画面主题 - 深色模式 (API 31+) -->
    <style name="Theme.ProjectU.Splash" parent="Theme.SplashScreen">
        <!-- 启动画面背景色 - 深色 (API 31+) -->
        <item name="android:windowSplashScreenBackground">#1A1C1E</item>
        
        <!-- 启动画面图标 - 使用自适应图标 -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        
        <!-- 图标背景色（可选,自适应图标已包含背景层） -->
        <!-- <item name="windowSplashScreenIconBackgroundColor">@color/primary</item> -->
        
        <!-- 状态栏和导航栏颜色 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- 启动后切换到应用主题 -->
        <item name="postSplashScreenTheme">@style/Theme.ProjectU</item>
    </style>

    <!-- 应用主题 - 深色模式 (API 31+) -->
    <style name="Theme.ProjectU" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
